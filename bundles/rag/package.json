{
  "name": "map-rag",
  "version": "0.1.0",
  "description": "Optional RAG context bundle: an MCP client row for the retrieval service and the policy that bounds what the agent may call and see",
  "private": true,
  "type": "module",
  "exports": {
    "./rag-policy": "./src/rag-policy.ts",
    "./package.json": "./package.json"
  },
  "files": ["src", "cordis.patch.yml"],
  "engines": { "dsh": ">=0.2.2-rc.2 <0.3.0" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  }
}
